# ── Where the server runs ───────────────────────────────────────────────
PORT=8787
# Comma-separated list of sites allowed to POST here (leave unset to allow all)
ALLOWED_ORIGIN=http://localhost:5173

# ── Email delivery (Gmail example) ──────────────────────────────────────
# For Gmail: turn on 2-step verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=raghulbabuj@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_TO=raghulbabuj@gmail.com

# ── WhatsApp delivery (Meta WhatsApp Cloud API) ─────────────────────────
# From https://developers.facebook.com → your app → WhatsApp → API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Your own number in international format, digits only, e.g. 9194429xxxxx
WHATSAPP_TO=
# Outside a 24h window Meta only delivers approved templates. Set the template
# name here once approved; leave empty to send plain text (works in testing).
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en_US
